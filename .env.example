# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3001

# Database (required in production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/quicktools

# Auth (JWT_SECRET required in production — no fallback)
JWT_SECRET=replace_with_long_random_string

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=Ov23liw8BazCFCXM91Gt
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI
GEMINI_API_KEYS=
# Premium scheduled covers. When enabled, image generation is OpenAI-only and
# publication fails closed instead of silently using a lower-quality provider.
OPENAI_IMAGE_ENABLED=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional realistic stock-photo source. If omitted, Cloudflare Workers AI is used.
PEXELS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_ENABLED=false
IMAGE_REVIEW_FAIL_OPEN_ON_UNAVAILABLE=true
# Keep false for fail-closed publishing. When false, a failed generated image
# skips the post instead of attaching a generic image-library asset.
IMAGE_LIBRARY_FALLBACK_ENABLED=false

# Cron protection
CRON_SECRET=

# Email (optional)
EMAIL_USER=
EMAIL_PASS=
