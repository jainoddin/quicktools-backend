# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3001

# Database (required in production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/quicktools

# Auth (JWT_SECRET required in production — no fallback)
JWT_SECRET=replace_with_long_random_string

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=Ov23liw8BazCFCXM91Gt
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI
GEMINI_API_KEYS=
# Optional realistic stock-photo source. If omitted, Cloudflare Workers AI is used.
PEXELS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_ENABLED=false

# Cron protection
CRON_SECRET=

# Email (optional)
EMAIL_USER=
EMAIL_PASS=
